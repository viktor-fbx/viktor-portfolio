---
// "/" no tiene contenido propio: lleva a /es/ (o a /en/, /fr/ según el navegador).
// Sin JavaScript (y para buscadores) el meta refresh envía a /es/.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const target = `${base}/es/`;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <title>Victor Hugo Amador</title>
        <meta name="robots" content="noindex" />
        <meta http-equiv="refresh" content={`0; url=${target}`} />
        <link rel="canonical" href={target} />
        <script is:inline define:vars={{ base }}>
            var l = (navigator.language || "es").slice(0, 2);
            location.replace(base + "/" + (l === "en" || l === "fr" ? l : "es") + "/" + location.hash);
        </script>
    </head>
    <body>
        <a href={target}>Victor Hugo Amador</a>
    </body>
</html>
