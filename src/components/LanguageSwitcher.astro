---
import { translations } from "../i18n/translations";
import { getLangFromUrl, switchLangPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const options = [
    { code: "es", label: "🇲🇽 ES" },
    { code: "en", label: "🇺🇸 EN" },
    { code: "fr", label: "🇫🇷 FR" },
] as const;
---

<div class="language-selector">
    <select
        data-lang-select
        class="language-dropdown"
        aria-label={translations[lang].a11y.language}
    >
        {options.map((o) => (
            <option
                value={switchLangPath(Astro.url, o.code)}
                selected={o.code === lang}
            >
                {o.label}
            </option>
        ))}
    </select>
</div>

<script>
    import { navigate } from "astro:transitions/client";

    // Un solo listener global: sigue funcionando aunque la página se reemplace
    document.addEventListener("change", (e) => {
        const el = e.target as HTMLElement;
        if (el instanceof HTMLSelectElement && el.hasAttribute("data-lang-select")) {
            navigate(el.value);
        }
    });
</script>

<style>
    .language-selector {
        position: relative;
    }

    .language-dropdown {
        padding: 0.3rem 0.6rem;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        color: #1e3a8a;
        font-weight: 500;
        cursor: pointer;
        outline: none;
        transition: all 0.3s ease;
        font-size: 0.75rem;
        min-width: 60px;
    }

    @media (min-width: 640px) {
        .language-dropdown {
            padding: 0.4rem 0.8rem;
            font-size: 0.8rem;
            min-width: 70px;
        }
    }

    @media (min-width: 1024px) {
        .language-dropdown {
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
            min-width: 80px;
        }
    }
</style>
