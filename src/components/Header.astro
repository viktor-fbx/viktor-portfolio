---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { translations } from "../i18n/translations";
import { getLangFromUrl, localePath, asset } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = translations[lang];

const homePath = localePath(lang);
const normalize = (p: string) => p.replace(/\/$/, "");
// Página principal = /es, /en o /fr (con o sin barra final)
const isHomePage = normalize(Astro.url.pathname) === normalize(homePath);
const galleryPath = localePath(lang, "/projects/3D-gallery/");
const anchor = (id: string) => (isHomePage ? `#${id}` : `${homePath}#${id}`);
---

<header
    data-home={isHomePage ? "true" : "false"}
    class="sticky top-4 flex justify-between items-center mx-4 sm:mx-auto w-full sm:w-[95%] lg:w-[1120px] rounded-full px-4 sm:px-6 py-2 my-4 bg-white/10 backdrop-blur-md border-white border-1 inset-shadow-sm shadow-md z-50"
>
    <a href={homePath} class="flex-shrink-0">
        <img
            src={asset("/media/img/Viktor-logo-liquid-metal.png")}
            alt={t.a11y.logoAlt}
            width={85}
            height={85}
            class="w-[50px] sm:w-[70px] lg:w-[85px] h-auto"
            loading="eager"
        />
    </a>

    <nav
        class="hidden md:flex flex-row gap-x-6 lg:gap-x-8 justify-center opacity-70 text-base lg:text-md"
    >
        <a
            href={anchor("about")}
            class="hover:text-blue-300 transition-colors duration-200 whitespace-nowrap py-1 nav-link"
        >
            {t.nav.about}
        </a>
        <a
            href={anchor("skills")}
            class="hover:text-blue-300 transition-colors duration-200 whitespace-nowrap py-1 nav-link"
        >
            {t.nav.skills}
        </a>
        <a
            href={anchor("projects")}
            class="hover:text-blue-300 transition-colors duration-200 whitespace-nowrap py-1 nav-link"
        >
            {t.nav.projects}
        </a>
        <a
            href={galleryPath}
            class="hover:text-blue-300 transition-colors duration-200 whitespace-nowrap py-1 nav-link"
        >
            {t.gallery.title}
        </a>
    </nav>

    <div class="flex items-center gap-x-3 sm:gap-x-4">
        <LanguageSwitcher />

        <button
            class="md:hidden flex flex-col justify-center items-center w-8 h-8 relative group"
            id="menu-toggle"
            type="button"
            aria-label={t.a11y.openMenu}
        >
            <span
                class="w-6 h-0.5 bg-blue-900/70 mb-1.5 transition-all duration-300 group-[.active]:rotate-45 group-[.active]:mb-0 group-[.active]:translate-y-1"
            ></span>
            <span
                class="w-6 h-0.5 bg-blue-900/70 mb-1.5 transition-all duration-300 group-[.active]:opacity-0"
            ></span>
            <span
                class="w-6 h-0.5 bg-blue-900/70 transition-all duration-300 group-[.active]:-rotate-45 group-[.active]:-translate-y-1"
            ></span>
        </button>
    </div>

    <!-- Móvil -->
    <div
        class="absolute top-full left-0 right-0 bg-white/70 backdrop-blur-xl border-white border-1 inset-shadow-sm shadow-md rounded-2xl mx-4 mt-2 p-4 opacity-0 invisible transition-all duration-300 translate-y-2 md:hidden"
        id="mobile-menu"
    >
        <nav class="flex flex-col gap-2">
            <a
                href={anchor("about")}
                class="text-blue-900/70 font-medium hover:text-blue-300 transition-colors duration-200 whitespace-nowrap py-3 px-4 rounded-lg hover:bg-white/20 text-center nav-link"
                data-menu-close
            >
                {t.nav.about}
            </a>
            <a
                href={anchor("skills")}
                class="text-blue-900/70 font-medium hover:text-blue-300 transition-colors duration-200 whitespace-nowrap py-3 px-4 rounded-lg hover:bg-white/20 text-center nav-link"
                data-menu-close
            >
                {t.nav.skills}
            </a>
            <a
                href={anchor("projects")}
                class="text-blue-900/70 font-medium hover:text-blue-300 transition-colors duration-200 whitespace-nowrap py-3 px-4 rounded-lg hover:bg-white/20 text-center nav-link"
                data-menu-close
            >
                {t.nav.projects}
            </a>
            <a
                href={galleryPath}
                class="text-blue-900/70 font-medium hover:text-blue-300 transition-colors duration-200 whitespace-nowrap py-3 px-4 rounded-lg hover:bg-white/20 text-center nav-link"
                data-menu-close
            >
                {t.gallery.title}
            </a>

        </nav>
    </div>

    <script>
        // Módulo: se ejecuta una sola vez. Los listeners por página se
        // enganchan en "astro:page-load" (carga inicial y cada navegación).
        function closeMenu() {
            const menuToggle = document.getElementById("menu-toggle");
            const mobileMenu = document.getElementById("mobile-menu");
            if (!menuToggle || !mobileMenu) return;
            menuToggle.classList.remove("active");
            mobileMenu.classList.add("opacity-0", "invisible", "translate-y-2");
            mobileMenu.classList.remove("opacity-100", "visible", "translate-y-0");
        }

        function toggleMenu() {
            const menuToggle = document.getElementById("menu-toggle");
            const mobileMenu = document.getElementById("mobile-menu");
            if (!menuToggle || !mobileMenu) return;
            menuToggle.classList.toggle("active");
            mobileMenu.classList.toggle("opacity-0");
            mobileMenu.classList.toggle("invisible");
            mobileMenu.classList.toggle("translate-y-2");
            mobileMenu.classList.toggle("opacity-100");
            mobileMenu.classList.toggle("visible");
            mobileMenu.classList.toggle("translate-y-0");
        }

        // Listeners de documento: se registran una vez y buscan el DOM actual
        document.addEventListener("click", (event) => {
            const target = event.target as Node;
            const menuToggle = document.getElementById("menu-toggle");
            const mobileMenu = document.getElementById("mobile-menu");
            if (!menuToggle || !mobileMenu) return;

            if (menuToggle.contains(target)) {
                event.stopPropagation();
                toggleMenu();
                return;
            }
            if (
                mobileMenu.classList.contains("opacity-100") &&
                !mobileMenu.contains(target)
            ) {
                closeMenu();
            }
        });

        document.addEventListener("keydown", (event) => {
            const mobileMenu = document.getElementById("mobile-menu");
            if (event.key === "Escape" && mobileMenu?.classList.contains("opacity-100")) {
                closeMenu();
            }
        });

        document.addEventListener("astro:page-load", () => {
            const header = document.querySelector("header[data-home]");
            const isHome = header?.getAttribute("data-home") === "true";

            document.querySelectorAll("[data-menu-close]").forEach((item) =>
                item.addEventListener("click", closeMenu),
            );

            document.querySelectorAll<HTMLAnchorElement>(".nav-link").forEach((link) => {
                link.addEventListener("click", (e) => {
                    const href = link.getAttribute("href") ?? "";
                    // Ancla dentro de la home: scroll suave sin navegar
                    if (isHome && href.startsWith("#")) {
                        e.preventDefault();
                        const target = document.getElementById(href.slice(1));
                        if (target) {
                            closeMenu();
                            target.scrollIntoView({ behavior: "smooth", block: "start" });
                            history.pushState(null, "", href);
                        }
                    }
                });
            });
        });
    </script>

    <style>
        /* Header centrado correctamente */
        header {
            position: sticky !important;
            top: 1rem !important;
            left: 0 !important;
            right: 0 !important;
            margin: 0 auto !important;
            width: 95% !important;
            max-width: 1120px !important;
            transform: none !important;
        }

        /* Para móviles */
        @media (max-width: 767px) {
            header {
                width: calc(100% - 2rem) !important;
                left: 1rem !important;
                right: 1rem !important;
            }
        }

        /* Para pantallas muy pequeñas */
        @media (max-width: 480px) {
            header {
                width: calc(100% - 1rem) !important;
                left: 0.5rem !important;
                right: 0.5rem !important;
            }
        }
    </style>
</header>
