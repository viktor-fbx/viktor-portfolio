---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { translations } from "../i18n/translations";
import { languages, getLangFromUrl, switchLangPath, asset } from "../i18n/utils";
import "../styles/global.css";
import "@fontsource-variable/onest";

interface Props {
    title: string;
    description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = translations[lang];
const { title, description = t.meta.description } = Astro.props;

const origin = Astro.site!;
const absolute = (path: string) => new URL(path, origin).href;
const canonical = absolute(switchLangPath(Astro.url, lang));
const alternates = languages.map((l) => ({
    lang: l,
    href: absolute(switchLangPath(Astro.url, l)),
}));
const ogLocale = { es: "es_MX", en: "en_US", fr: "fr_FR" } as const;
const ogImage = absolute(asset("/media/img/VictorHugoAmador.jpg"));

const schema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Victor Hugo Amador",
    jobTitle: t.hero.subtitle,
    url: canonical,
    image: ogImage,
    inLanguage: lang,
    sameAs: [
        "https://www.linkedin.com/in/victor-hugo-amador-enriquez-527695318/",
        "https://github.com/vSk8erB0i",
        "https://www.instagram.com/viktor.fbx/",
    ],
};
---

<!doctype html>
<html lang={lang}>
    <head>
        <script defer src="https://cloud.umami.is/script.js" data-website-id="e3b8e960-f8d4-4253-993d-661a0113d23e"></script>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href={asset("/media/apple-touch-icon.png")}
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href={asset("/media/favicon-32x32.png")}
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href={asset("/media/favicon-16x16.png")}
        />
        <link rel="manifest" href={asset("/media/site.webmanifest")} />
        <link rel="icon" href={asset("/media/favicon.ico")} sizes="any" />

        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />

        <!-- SEO multidioma -->
        <link rel="canonical" href={canonical} />
        {alternates.map((a) => (
            <link rel="alternate" hreflang={a.lang} href={a.href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={alternates[0].href} />

        <!-- Open Graph / Twitter -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:locale" content={ogLocale[lang]} />
        {languages
            .filter((l) => l !== lang)
            .map((l) => (
                <meta property="og:locale:alternate" content={ogLocale[l]} />
            ))}
        <meta name="twitter:card" content="summary" />

        <script type="application/ld+json" set:html={JSON.stringify(schema)} />

        <!-- Navegación entre idiomas/páginas sin recarga completa -->
        <ClientRouter />
    </head>
    <body>
        <div class="inset-0 -z-10 overflow-hidden">
            <div
                class="h-full w-full [background:radial-gradient(125%_125%_at_50%_10%,rgba(240,249,255,0.7)_15%,rgba(14,165,233,0.25)_40%,rgba(5,150,105,0.2)_100%)]"
            >
            </div>
        </div>
        <Header />
        <slot />
        <Footer />
    </body>
</html>

<style is:global>
    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
        font-family: "Onest Variable", sans-serif;
        height: 100%;
    }

    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
        /* FONDO DIRECTO EN EL BODY */
        background: radial-gradient(
            125% 125% at 50% 10%,
            rgba(240, 249, 255, 0.7) 15%,
            rgba(14, 165, 233, 0.25) 40%,
            rgba(5, 150, 105, 0.2) 100%
        );
        background-attachment: fixed; /* Esto hace que el fondo cubra toda la página */
    }

    .main-content {
        position: relative;
        z-index: 1;
        min-height: 100vh;
    }

    main {
        width: 100%;
        overflow-x: hidden;
    }

    /* Scroll suave entre secciones */
    section,
    [id] {
        scroll-margin-top: 80px;
    }
</style>
